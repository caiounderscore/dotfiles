[user]
	name = Caio Rodrigues
	email = dev@caiounderscore.xyz

# Per-directory identity override: any repo under ~/work/ uses the work
# identity from ~/.gitconfig-work (a per-machine, untracked file — see
# .gitconfig-work.example). Keep all work clones under ~/work/.
[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[core]
	editor = vim

[color]
	ui = auto

# Use SSH for Bitbucket even when a remote is configured with an https URL.
[url "git@bitbucket.org:"]
	insteadOf = https://bitbucket.org/

[alias]
	st = status
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
