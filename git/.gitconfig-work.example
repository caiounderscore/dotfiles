# Copy to ~/.gitconfig-work on your work machine and fill in the work email.
# This file is untracked (see .gitignore) so the work identity never lands in
# the repo. Activated automatically for any repo under ~/work/ or
# ~/projects/cactus/ via the includeIf rules in .gitconfig.
[user]
	email = caio@company.com
	# Only needed if the org enforces "require signed commits" and the work
	# SSH key isn't already registered as a Signing Key on the work GitHub
	# account (separate registration from the Authentication Key).
	# signingkey = ~/.ssh/id_ed25519.pub

# [gpg]
# 	format = ssh

# [commit]
# 	gpgsign = true
