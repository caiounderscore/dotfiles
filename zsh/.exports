# Homebrew: puts /opt/homebrew/bin (Apple Silicon) or /usr/local/bin (Intel) on
# PATH. Without this, everything installed via the Brewfile (kubectl, colima,
# stow, jq, yazi, ...) is invisible to the shell — kdev/klocal/k etc. all fail
# with "command not found: kubectl" regardless of kube-context.
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.opencode/bin:$HOME/.local/bin:$PATH"
export NVM_DIR="$HOME/.nvm"
export CLAUDE_CODE_DISABLE_MOUSE_CLICKS=0
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"

# Orca ships its CLI inside the app bundle; expose it when the app is installed so agents
# and task-workspace can manage Orca worktrees and tasks. Without Orca nothing changes.
for orca_app in "$HOME/Applications/Orca.app" /Applications/Orca.app; do
  if [ -x "$orca_app/Contents/Resources/bin/orca" ]; then
    case ":$PATH:" in
      *":$orca_app/Contents/Resources/bin:"*) ;;
      *) export PATH="$PATH:$orca_app/Contents/Resources/bin" ;;
    esac
    break
  fi
done
unset orca_app
