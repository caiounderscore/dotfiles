alias k='kubectl'

# `watch` → hwatch: a scrollable in-memory history of past frames plus their
# diffs, instead of only the latest frame. Alias/function resolution is
# preserved with `-s 'zsh +m -ic'`: `-i` sources ~/.zshrc so `k`, `klocal`,
# etc. resolve, while `+m` disables job control (monitor mode). Without `+m`
# the interactive child grabs the terminal and hwatch's navigation keys trip
# SIGTTIN ("suspended (tty input)"); job control is useless for a one-shot
# run anyway. Falls back to procps `watch` when hwatch is absent
# (minimal/remote boxes); plain procps watch stays reachable as `command watch`.
#
#   watch [--log] [--notify] [hwatch options...] <command...>
#     --log     also append a timestamped JSON log under ${TMPDIR:-/tmp}/hwatch/
#               — opt-in and ephemeral (the tmp dir is cleared on reboot). It
#               records whatever the command prints, so only use it when that
#               output is safe to land on disk.
#     --notify  alert when the output changes (macOS: a sound via afplay;
#               elsewhere: the terminal bell).
# Our two flags must lead; everything after them flows through to hwatch as-is.
watch() {
  local do_log=0 do_notify=0
  while (( $# )); do
    case "$1" in
      --log)    do_log=1;    shift ;;
      --notify) do_notify=1; shift ;;
      --)       shift; break ;;
      *)        break ;;
    esac
  done

  # No hwatch: keep the original behavior so remote/minimal boxes don't break.
  if (( ! ${+commands[hwatch]} )); then
    command watch -x zsh +m -ic "$*"
    return
  fi

  local -a opts=(-c -s 'zsh +m -ic')

  if (( do_log )); then
    local dir="${TMPDIR:-/tmp}/hwatch"
    mkdir -p "$dir" && chmod 700 "$dir"
    opts+=(-l "$dir/watch-$(date +%Y%m%d-%H%M%S)-$$.jsonl")
  fi

  if (( do_notify )); then
    if [[ "$OSTYPE" == darwin* ]] && [[ -x /usr/bin/afplay ]]; then
      opts+=(-A 'nohup /usr/bin/afplay -v 0.35 /System/Library/Sounds/Submarine.aiff >/dev/null 2>&1 &')
    else
      opts+=(-B)
    fi
  fi

  hwatch "${opts[@]}" "$@"
}

# Kubernetes environment shortcuts. local/dev use contexts in the default
# kubeconfig. sandbox and production each use a separate kubeconfig file so
# their credentials and current-context state cannot collide with other
# clusters. The production file is an ephemeral break-glass credential.
: ${K8S_LOCAL_CONTEXT:=colima}
: ${K8S_SANDBOX_KUBECONFIG:=$HOME/.bladecp-sandbox/talos/generated/kubeconfig}
: ${K8S_SANDBOX_CONTEXT:=admin@bcp-sandbox-control-plane}
: ${K8S_DEV_CONTEXT:=dev}
: ${K8S_PROD_CONTEXT:=bladecp-production}
: ${K8S_PROD_KUBECONFIG:=$HOME/.kube/bladecp-production}
: ${BCP_CONTROL_PLANE_REPO:=$HOME/projects/bladecp/gcp-k8s-control-plane}
# The production API host and TLS name stay out of this public repo: set
# K8S_PROD_API_HOST and K8S_PROD_TLS_SERVER_NAME in ~/.zshrc.local.

# Low-risk environments: switch kubectl's current-context for the rest of the
# session (convenience), then optionally run a command against it right away.
# Reset KUBECONFIG first in case a prior `ksandbox` call left it pointed at
# the sandbox kubeconfig file — local/dev must always target the default one.
klocal() {
  unset KUBECONFIG
  kubectl config use-context "$K8S_LOCAL_CONTEXT" || return 1
  echo "Switched to local (${K8S_LOCAL_CONTEXT})"
  [ $# -eq 0 ] && return 0
  kubectl "$@"
}
# Sandbox is a separate kubeconfig file (see comment above), so "switching" to
# it means pointing KUBECONFIG at that file for the rest of the session,
# rather than a use-context call against the default kubeconfig.
ksandbox() {
  if [ ! -f "$K8S_SANDBOX_KUBECONFIG" ]; then
    echo "ksandbox: kubeconfig not found at $K8S_SANDBOX_KUBECONFIG" >&2
    return 1
  fi
  # Fail closed: a later get-credentials/use-context in a ksandbox session
  # writes into this file, and once retargeted it must not pass as sandbox.
  local current
  current=$(kubectl --kubeconfig "$K8S_SANDBOX_KUBECONFIG" config current-context 2>/dev/null)
  if [ "$current" != "$K8S_SANDBOX_CONTEXT" ]; then
    echo "ksandbox: current context in $K8S_SANDBOX_KUBECONFIG is '${current:-none}', expected $K8S_SANDBOX_CONTEXT" >&2
    return 1
  fi
  export KUBECONFIG="$K8S_SANDBOX_KUBECONFIG"
  echo "Switched to sandbox (using $K8S_SANDBOX_KUBECONFIG)"
  [ $# -eq 0 ] && return 0
  kubectl "$@"
}
kdev() {
  unset KUBECONFIG
  kubectl config use-context "$K8S_DEV_CONTEXT" || return 1
  echo "Switched to dev (${K8S_DEV_CONTEXT})"
  [ $# -eq 0 ] && return 0
  kubectl "$@"
}

# Generate the short-lived production kubeconfig through the private runner.
# Talos secrets and derived files stay on the runner; only the final validated
# kubeconfig is streamed to the dedicated local path.
kprod-auth() {
  local helper="$BCP_CONTROL_PLANE_REPO/scripts/fetch-ephemeral-admin-kubeconfig.sh"
  if [ ! -x "$helper" ]; then
    echo "kprod-auth: helper not found or not executable at $helper" >&2
    return 1
  fi
  "$helper" --output "$K8S_PROD_KUBECONFIG"
}

# Production uses a dedicated kubeconfig only for the invoked command. It also
# checks the Tailscale-routed API before any kubectl operation.
typeset -ga _k8s_read_only_verbs=(
  api-resources api-versions cluster-info describe diff events explain
  get list logs options top version
)
typeset -ga _k8s_mutating_verbs=(
  annotate apply attach auth autoscale certificate cordon cp create debug delete
  drain edit exec expose label patch replace rollout run scale set taint uncordon
)

kprod() {
  local operation="" option_value="" confirm=""
  local -a arguments=("$@")
  local -i index=1

  while (( index <= ${#arguments[@]} )); do
    case "${arguments[index]}" in
      --context)
        (( index < ${#arguments[@]} )) || {
          echo "kprod: --context requires a value" >&2
          return 1
        }
        option_value="${arguments[index + 1]}"
        [[ "$option_value" == "$K8S_PROD_CONTEXT" ]] || {
          echo "kprod: refusing context override: $option_value" >&2
          return 1
        }
        (( index += 2 ))
        ;;
      --context=*)
        option_value="${arguments[index]#--context=}"
        [[ "$option_value" == "$K8S_PROD_CONTEXT" ]] || {
          echo "kprod: refusing context override: $option_value" >&2
          return 1
        }
        (( index++ ))
        ;;
      --kubeconfig|--kubeconfig=*|--cluster|--cluster=*|--user|--user=*|--server|--server=*|-s|-s?*|--token|--token=*|--username|--username=*|--password|--password=*|--client-certificate|--client-certificate=*|--client-key|--client-key=*|--certificate-authority|--certificate-authority=*|--insecure-skip-tls-verify|--insecure-skip-tls-verify=*|--tls-server-name|--tls-server-name=*|--as|--as=*|--as-group|--as-group=*|--as-uid|--as-uid=*)
        echo "kprod: refusing production target or identity override: ${arguments[index]}" >&2
        return 1
        ;;
      *)
        (( index++ ))
        ;;
    esac
  done
  index=1

  if [ ! -f "$K8S_PROD_KUBECONFIG" ]; then
    echo "kprod: ephemeral kubeconfig not found; run kprod-auth first" >&2
    return 1
  fi
  if [ "$(kubectl --kubeconfig "$K8S_PROD_KUBECONFIG" config current-context 2>/dev/null)" != "$K8S_PROD_CONTEXT" ]; then
    echo "kprod: kubeconfig does not select $K8S_PROD_CONTEXT" >&2
    return 1
  fi
  if [ -z "${K8S_PROD_API_HOST-}" ]; then
    echo "kprod: set K8S_PROD_API_HOST in ~/.zshrc.local" >&2
    return 1
  fi
  if ! nc -z -w 5 "$K8S_PROD_API_HOST" 6443; then
    echo "BladeCP production API is not reachable. Verify that Tailscale is connected." >&2
    return 1
  fi

  if [ $# -gt 0 ]; then
    while (( index <= ${#arguments[@]} )); do
      case "${arguments[index]}" in
        -n|--namespace|--request-timeout|--cache-dir|--profile|--profile-output|-v|--v|--vmodule)
          (( index < ${#arguments[@]} )) || {
            echo "kprod: ${arguments[index]} requires a value" >&2
            return 1
          }
          (( index += 2 ))
          ;;
        -n?*|--namespace=*|--request-timeout=*|--cache-dir=*|--profile=*|--profile-output=*|-v?*|--v=*|--vmodule=*)
          (( index++ ))
          ;;
        --context)
          (( index += 2 ))
          ;;
        --context=*)
          (( index++ ))
          ;;
        --disable-compression|--disable-compression=*|--match-server-version|--match-server-version=*|--warnings-as-errors|--warnings-as-errors=*)
          (( index++ ))
          ;;
        -*)
          echo "kprod: cannot safely classify option before operation: ${arguments[index]}" >&2
          return 1
          ;;
        *)
          operation="${arguments[index]}"
          break
          ;;
      esac
    done

    [[ -n "$operation" ]] || {
      echo "kprod: no kubectl operation found" >&2
      return 1
    }

    if (( ${_k8s_mutating_verbs[(Ie)$operation]} )); then
      printf '\033[1;31m⚠️  PRODUCTION (%s): about to run `kubectl %s`\033[0m\n' "$K8S_PROD_CONTEXT" "$*"
      printf 'Type "yes" to continue: '
      read -r confirm
      if [ "$confirm" != "yes" ]; then
        echo "Aborted."
        return 1
      fi
    elif (( ! ${_k8s_read_only_verbs[(Ie)$operation]} )); then
      echo "kprod: cannot safely classify kubectl operation: $operation" >&2
      return 1
    fi
    KUBECONFIG="$K8S_PROD_KUBECONFIG" kubectl "$@"
  else
    echo "BladeCP production context is available through kprod commands."
  fi
}

# Explicitly switch the current shell to the Talos-managed BladeCP production
# cluster. Unlike kprod's command-scoped access, this makes subsequent `k` and
# `kubectl` commands use the dedicated production kubeconfig until switched
# away or the shell exits.
kprodtalos() {
  local context cluster server tls_server_name

  if [ ! -f "$K8S_PROD_KUBECONFIG" ]; then
    echo "kprodtalos: ephemeral kubeconfig not found; run kprod-auth first" >&2
    return 1
  fi
  if [[ -z "${K8S_PROD_API_HOST-}" || -z "${K8S_PROD_TLS_SERVER_NAME-}" ]]; then
    echo "kprodtalos: set K8S_PROD_API_HOST and K8S_PROD_TLS_SERVER_NAME in ~/.zshrc.local" >&2
    return 1
  fi

  context=$(kubectl --kubeconfig "$K8S_PROD_KUBECONFIG" config current-context 2>/dev/null) || {
    echo "kprodtalos: cannot read the production kubeconfig context" >&2
    return 1
  }
  [[ "$context" == "$K8S_PROD_CONTEXT" ]] || {
    echo "kprodtalos: kubeconfig does not select $K8S_PROD_CONTEXT" >&2
    return 1
  }

  cluster=$(kubectl --kubeconfig "$K8S_PROD_KUBECONFIG" config view --minify -o 'jsonpath={.contexts[0].context.cluster}' 2>/dev/null) || {
    echo "kprodtalos: cannot read the production kubeconfig cluster" >&2
    return 1
  }
  server=$(kubectl --kubeconfig "$K8S_PROD_KUBECONFIG" config view --minify -o 'jsonpath={.clusters[0].cluster.server}' 2>/dev/null) || {
    echo "kprodtalos: cannot read the production Kubernetes API endpoint" >&2
    return 1
  }
  tls_server_name=$(kubectl --kubeconfig "$K8S_PROD_KUBECONFIG" config view --minify -o 'jsonpath={.clusters[0].cluster.tls-server-name}' 2>/dev/null) || {
    echo "kprodtalos: cannot read the production TLS server name" >&2
    return 1
  }

  [[ -n "$cluster" && "$server" == "https://$K8S_PROD_API_HOST:6443" && "$tls_server_name" == "$K8S_PROD_TLS_SERVER_NAME" ]] || {
    echo "kprodtalos: refusing an unexpected production cluster target" >&2
    return 1
  }
  if ! nc -z -w 5 "$K8S_PROD_API_HOST" 6443; then
    echo "kprodtalos: BladeCP Talos API is unreachable; verify Tailscale" >&2
    return 1
  fi

  export KUBECONFIG="$K8S_PROD_KUBECONFIG"
  printf '\033[1;31mSwitched current shell to Talos production (%s).\033[0m\n' "$context"
  printf 'Use kprod for guarded mutations; run kprodtalos-off to return to the default kubeconfig.\n'
  [ $# -eq 0 ] && return 0
  kprod "$@"
}

kprodtalos-off() {
  if [ "${KUBECONFIG:-}" != "$K8S_PROD_KUBECONFIG" ]; then
    echo "kprodtalos-off: the current shell is not using the Talos production kubeconfig"
    return 0
  fi
  unset KUBECONFIG
  echo "Returned to the default kubeconfig ($(kubectl config current-context 2>/dev/null || echo unknown))."
}

# Backward-compatible names for shells or notes that used the original typo.
kprdtalos() { kprodtalos "$@"; }
kprdtalos-off() { kprodtalos-off "$@"; }

kprod-clean() {
  if [ "${KUBECONFIG:-}" = "$K8S_PROD_KUBECONFIG" ]; then
    unset KUBECONFIG
  fi
  if [ -e "$K8S_PROD_KUBECONFIG" ] || [ -L "$K8S_PROD_KUBECONFIG" ]; then
    rm -f -- "$K8S_PROD_KUBECONFIG"
    echo "Removed ephemeral BladeCP production kubeconfig."
  else
    echo "No ephemeral BladeCP production kubeconfig exists."
  fi
}

# Restart the current shell session from scratch (fresh process, not just re-sourcing)
alias reload='exec zsh -l'

# Codex's native sleep inhibitor follows the turn lifecycle: active work keeps
# macOS awake, while an open client waiting at the prompt does not.
codex() {
  if [[ "$OSTYPE" == darwin* ]]; then
    command codex --enable prevent_idle_sleep "$@"
  else
    command codex "$@"
  fi
}

# Drop-in Docker CLI compatibility on top of Colima + nerdctl (containerd runtime)
alias docker='nerdctl'
alias docker-compose='nerdctl compose'

# List/search ~/.agents/skills, e.g. `skills`, `skills agent`, or `skills -d agent`.
skills() {
  local show_desc=0
  if [ "${1:-}" = "-d" ]; then
    show_desc=1
    shift
  fi
  local term="$*"
  local skills_dir="${SKILLS_DIR:-$HOME/.agents/skills}"
  [ -d "$skills_dir" ] || return 0

  local -a skill_files
  skill_files=("$skills_dir"/*/SKILL.md(N))
  (( ${#skill_files[@]} > 0 )) || return 0

  awk -v term="$term" -v show_desc="$show_desc" '
      function emit() {
        if (name == "") return
        if (needle == "" || index(tolower(name " " desc), needle) > 0) {
          if (show_desc) printf "%s — %s\n", name, desc
          else print name
        }
      }
      BEGIN { needle = tolower(term); squote = sprintf("%c", 39) }
      FNR==1 {
        if (NR>1) emit()
        file_name=FILENAME
        sub(/\/SKILL\.md$/, "", file_name)
        sub(/^.*\//, "", file_name)
        in_fm=0; name=file_name; desc=""; block=0
      }
      /^---[ \t]*$/ { in_fm++; if (in_fm==2) nextfile; next }
      in_fm==1 {
        if ($0 ~ /^name:[ \t]*/) {
          name=$0; sub(/^name:[ \t]*/,"",name); gsub(/^"|"$/,"",name)
          if (substr(name,1,1)==squote && substr(name,length(name),1)==squote) name=substr(name,2,length(name)-2)
          block=0
        } else if ($0 ~ /^description:[ \t]*/) {
          desc=$0; sub(/^description:[ \t]*/,"",desc)
          if (desc==">" || desc=="|" || desc==">-" || desc=="|-") { block=1; desc="" }
          else {
            gsub(/^"|"$/,"",desc)
            if (substr(desc,1,1)==squote && substr(desc,length(desc),1)==squote) desc=substr(desc,2,length(desc)-2)
            block=0
          }
        } else if (block==1 && $0 ~ /^[ \t]+/) {
          line=$0; sub(/^[ \t]+/,"",line); desc = (desc=="") ? line : desc " " line
        } else { block=0 }
      }
      END { emit() }
    ' "${skill_files[@]}" | sort -u | {
      if [ -n "$term" ]; then
        GREP_COLOR='38;5;213' grep --color=auto -iF -- "$term"
      else
        cat
      fi
    }
}
