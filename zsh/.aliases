alias k='kubectl'

# `watch` → hwatch: a scrollable in-memory history of past frames plus their
# diffs, instead of only the latest frame. Alias/function resolution is
# preserved with `-s 'zsh +m -ic'`: `-i` sources ~/.zshrc so `k`, `klocal`,
# etc. resolve, while `+m` disables job control (monitor mode). Without `+m`
# the interactive child grabs the terminal and hwatch's navigation keys trip
# SIGTTIN ("suspended (tty input)"); job control is useless for a one-shot
# run anyway. Falls back to procps `watch` when hwatch is absent
# (minimal/remote boxes); plain procps watch stays reachable as `command watch`.
#
#   watch [--log] [--notify] [hwatch options...] <command...>
#     --log     also append a timestamped JSON log under ${TMPDIR:-/tmp}/hwatch/
#               — opt-in and ephemeral (the tmp dir is cleared on reboot). It
#               records whatever the command prints, so only use it when that
#               output is safe to land on disk.
#     --notify  alert when the output changes (macOS: a sound via afplay;
#               elsewhere: the terminal bell).
# Our two flags must lead; everything after them flows through to hwatch as-is.
watch() {
  local do_log=0 do_notify=0
  while (( $# )); do
    case "$1" in
      --log)    do_log=1;    shift ;;
      --notify) do_notify=1; shift ;;
      --)       shift; break ;;
      *)        break ;;
    esac
  done

  # No hwatch: keep the original behavior so remote/minimal boxes don't break.
  if (( ! ${+commands[hwatch]} )); then
    command watch -x zsh +m -ic "$*"
    return
  fi

  local -a opts=(-c -s 'zsh +m -ic')

  if (( do_log )); then
    local dir="${TMPDIR:-/tmp}/hwatch"
    mkdir -p "$dir" && chmod 700 "$dir"
    opts+=(-l "$dir/watch-$(date +%Y%m%d-%H%M%S)-$$.jsonl")
  fi

  if (( do_notify )); then
    if [[ "$OSTYPE" == darwin* ]] && [[ -x /usr/bin/afplay ]]; then
      opts+=(-A 'nohup /usr/bin/afplay -v 0.35 /System/Library/Sounds/Submarine.aiff >/dev/null 2>&1 &')
    else
      opts+=(-B)
    fi
  fi

  hwatch "${opts[@]}" "$@"
}

# Kubernetes environment shortcuts. dev/prod context names are placeholders
# until real clusters get added to kubeconfig; local defaults to the real
# Colima k3s context. sandbox uses its own kubeconfig file rather than a
# context in the default one — its cluster/context/user names are the generic
# kubeadm defaults ("kubernetes-admin@kubernetes"), which collide with any
# other kubeadm-provisioned cluster's names, so it can't be safely merged in.
# Override per machine in .zshrc.local, e.g. `export K8S_PROD_CONTEXT=my-real-prod-context`.
: ${K8S_LOCAL_CONTEXT:=colima}
: ${K8S_SANDBOX_KUBECONFIG:=$HOME/.kube/config-remote}
: ${K8S_DEV_CONTEXT:=dev}
: ${K8S_PROD_CONTEXT:=prod}

# Low-risk environments: switch kubectl's current-context for the rest of the
# session (convenience), then optionally run a command against it right away.
# Reset KUBECONFIG first in case a prior `ksandbox` call left it pointed at
# the sandbox kubeconfig file — local/dev must always target the default one.
klocal() {
  unset KUBECONFIG
  kubectl config use-context "$K8S_LOCAL_CONTEXT" || return 1
  echo "Switched to local (${K8S_LOCAL_CONTEXT})"
  [ $# -eq 0 ] && return 0
  kubectl "$@"
}
# Sandbox is a separate kubeconfig file (see comment above), so "switching" to
# it means pointing KUBECONFIG at that file for the rest of the session,
# rather than a use-context call against the default kubeconfig.
ksandbox() {
  if [ ! -f "$K8S_SANDBOX_KUBECONFIG" ]; then
    echo "ksandbox: kubeconfig not found at $K8S_SANDBOX_KUBECONFIG" >&2
    return 1
  fi
  export KUBECONFIG="$K8S_SANDBOX_KUBECONFIG"
  echo "Switched to sandbox (using $K8S_SANDBOX_KUBECONFIG)"
  [ $# -eq 0 ] && return 0
  kubectl "$@"
}
kdev() {
  unset KUBECONFIG
  kubectl config use-context "$K8S_DEV_CONTEXT" || return 1
  echo "Switched to dev (${K8S_DEV_CONTEXT})"
  [ $# -eq 0 ] && return 0
  kubectl "$@"
}

# Production: never switches current-context (so a later bare `k`/`kubectl`
# can't silently land on prod) — every call is a one-off --context=prod, and
# mutating verbs require typing "yes" first. Verb detection assumes the verb
# is $1 (e.g. `kprod delete pod x -n foo`); global flags before the verb
# (e.g. `kprod -n foo delete ...`) aren't recognized as mutating.
typeset -ga _k8s_mutating_verbs=(
  apply delete scale patch replace edit create expose set autoscale
  cordon drain uncordon taint label annotate exec rollout
)

kprod() {
  if [ $# -eq 0 ]; then
    echo "Usage: kprod <kubectl-args...>"
    return 1
  fi
  local verb="$1"
  if (( ${_k8s_mutating_verbs[(Ie)$verb]} )); then
    printf '\033[1;31m⚠️  PRODUCTION (%s): about to run `kubectl %s`\033[0m\n' "$K8S_PROD_CONTEXT" "$*"
    printf 'Type "yes" to continue: '
    read confirm
    if [ "$confirm" != "yes" ]; then
      echo "Aborted."
      return 1
    fi
  fi
  # Explicit --kubeconfig, ignoring any KUBECONFIG left set by ksandbox — prod
  # must never silently resolve against the wrong file.
  kubectl --kubeconfig="$HOME/.kube/config" --context="$K8S_PROD_CONTEXT" "$@"
}

# Restart the current shell session from scratch (fresh process, not just re-sourcing)
alias reload='exec zsh -l'

# Drop-in Docker CLI compatibility on top of Colima + nerdctl (containerd runtime)
alias docker='nerdctl'
alias docker-compose='nerdctl compose'

# Create a task workspace with one Git worktree per repository. The source
# branch is explicit and all validation completes before any worktree is made.
task-workspace() {
  local usage="Usage: task-workspace --from <source-branch> [--workspace <path>] [--target-branch <branch>] <workspace-name> <repository> [repository ...]"
  local source_branch="" workspace_override="" target_branch="" workspace_name=""
  local workspace_input workspace_path source repo_root repo_name target_path
  local source_ref source_commit common_dir target_commit target_action
  local remote_ref remote_name_branch checked_out merge_base
  local requested_branch parent
  local -a repositories repo_names common_dirs source_refs source_commits
  local -a target_paths target_actions target_commits target_merge_bases problems created
  local -i index=1 inner=1

  while (( $# )); do
    case "$1" in
      --from)
        (( $# >= 2 )) || { echo "$usage" >&2; return 1; }
        source_branch="$2"
        shift 2
        ;;
      --workspace)
        (( $# >= 2 )) || { echo "$usage" >&2; return 1; }
        workspace_override="$2"
        shift 2
        ;;
      --target-branch)
        (( $# >= 2 )) || { echo "$usage" >&2; return 1; }
        target_branch="$2"
        shift 2
        ;;
      --)
        shift
        while (( $# )); do
          if [[ -z "$workspace_name" ]]; then
            workspace_name="$1"
          else
            repositories+=("$1")
          fi
          shift
        done
        ;;
      -*)
        problems+=("unknown option: $1")
        shift
        ;;
      *)
        if [[ -z "$workspace_name" ]]; then
          workspace_name="$1"
        else
          repositories+=("$1")
        fi
        shift
        ;;
    esac
  done

  [[ -n "$source_branch" ]] || problems+=("--from <source-branch> is required")
  [[ -n "$workspace_name" ]] || problems+=("workspace name is required")
  (( ${#repositories[@]} > 0 )) || problems+=("at least one repository is required")
  command -v git >/dev/null 2>&1 || problems+=("git is required")

  if [[ -n "$workspace_name" ]]; then
    if [[ "$workspace_name" == /* || "$workspace_name" == */ ||
          "$workspace_name" == *//* || "$workspace_name" == "." ||
          "$workspace_name" == ".." || "$workspace_name" == ../* ||
          "$workspace_name" == */../* || "$workspace_name" == */.. ||
          "$workspace_name" == */./* || "$workspace_name" == */. ]]; then
      problems+=("invalid workspace name path: $workspace_name")
    fi
  fi

  if [[ -n "$source_branch" ]]; then
    if ! git check-ref-format --branch "$source_branch" >/dev/null 2>&1 ||
       [[ "$source_branch" == refs/* ]]; then
      problems+=("invalid source branch name: $source_branch")
    fi
  fi

  if [[ -z "$target_branch" && -n "$workspace_name" ]]; then
    target_branch="$workspace_name"
  fi
  if [[ -n "$target_branch" ]] &&
     ! git check-ref-format --branch "$target_branch" >/dev/null 2>&1; then
    problems+=("invalid target branch name: $target_branch")
  fi

  if (( ${#problems[@]} == 0 )); then
    if [[ -n "$workspace_override" ]]; then
      workspace_input="$workspace_override"
    else
      workspace_input="${HOME}/workspaces/${workspace_name}"
    fi
    workspace_path="${workspace_input:A}"

    if [[ -L "$workspace_input" ]]; then
      problems+=("workspace root is a symlink: $workspace_input")
    elif [[ -e "$workspace_path" && ! -d "$workspace_path" ]]; then
      problems+=("workspace path is not a directory: $workspace_path")
    elif [[ -d "$workspace_path" && ! -w "$workspace_path" ]]; then
      problems+=("workspace directory is not writable: $workspace_path")
    else
      parent="$workspace_path"
      while [[ ! -e "$parent" && "$parent" != "/" ]]; do
        parent="${parent:h}"
      done
      [[ -d "$parent" && -w "$parent" ]] ||
        problems+=("workspace parent is not writable: $parent")
    fi
  fi

  for source in "${repositories[@]}"; do
    source="${source:A}"
    if [[ ! -d "$source" ]]; then
      problems+=("repository directory not found: $source")
      continue
    fi

    repo_root=$(git -C "$source" rev-parse --show-toplevel 2>/dev/null) || {
      problems+=("not a Git repository or worktree: $source")
      continue
    }
    repo_root="${repo_root:A}"
    if [[ "$repo_root" != "$source" ]]; then
      problems+=("repository path is not an exact root: $source")
      continue
    fi

    common_dir=$(git -C "$source" rev-parse --git-common-dir 2>/dev/null) || {
      problems+=("cannot resolve Git common directory: $source")
      continue
    }
    [[ "$common_dir" == /* ]] || common_dir="$source/$common_dir"
    common_dir="${common_dir:A}"
    repo_name="${repo_root:t}"

    for (( inner = 1; inner <= ${#common_dirs[@]}; inner++ )); do
      [[ "${common_dirs[inner]}" == "$common_dir" ]] &&
        problems+=("duplicate underlying repository: $source")
    done
    for (( inner = 1; inner <= ${#repo_names[@]}; inner++ )); do
      [[ "${repo_names[inner]}" == "$repo_name" ]] &&
        problems+=("duplicate repository target name: $repo_name")
    done

    if [[ "$source_branch" == origin/* ]]; then
      source_ref="refs/remotes/$source_branch"
    else
      source_ref="refs/heads/$source_branch"
    fi
    if ! git -C "$source" show-ref --verify --quiet "$source_ref"; then
      problems+=("source branch not found in $source: $source_branch")
      source_commit=""
    else
      source_commit=$(git -C "$source" rev-parse --verify "$source_ref^{commit}" 2>/dev/null) || {
        problems+=("source branch does not resolve to a commit in $source: $source_branch")
        source_commit=""
      }
    fi

    repo_names+=("$repo_name")
    common_dirs+=("$common_dir")
    source_refs+=("$source_ref")
    source_commits+=("$source_commit")
    target_paths+=("$workspace_path/$repo_name")
    target_commits+=("")
    target_actions+=("")
    target_merge_bases+=("")
  done

  if (( ${#problems[@]} == 0 )); then
    if [[ "$source_branch" != origin/* && "$source_branch" == "$target_branch" ]]; then
      problems+=("source and target branches are the same local branch: $target_branch")
    fi

    for (( index = 1; index <= ${#repo_names[@]}; index++ )); do
      source="${repositories[index]:A}"
      target_path="${target_paths[index]}"
      target_commit=""
      merge_base=""
      [[ ! -e "$target_path" && ! -L "$target_path" ]] ||
        problems+=("target already exists: $target_path")

      if git -C "$source" show-ref --verify --quiet "refs/heads/$target_branch"; then
        target_action="REUSE_BRANCH"
        target_commit=$(git -C "$source" rev-parse --verify "refs/heads/$target_branch^{commit}" 2>/dev/null) || {
          problems+=("target branch does not resolve to a commit in $source: $target_branch")
          target_commit=""
        }
        checked_out=$(git -C "$source" worktree list --porcelain 2>/dev/null | awk \
          -v wanted="refs/heads/$target_branch" \
          '$1 == "worktree" { path = substr($0, 10) } $1 == "branch" && $2 == wanted { print path; exit }')
        [[ -z "$checked_out" ]] ||
          problems+=("target branch already checked out in $source: $target_branch at $checked_out")
        if [[ -n "$target_commit" ]]; then
          merge_base=$(git -C "$source" merge-base "${source_commits[index]}" "$target_commit" 2>/dev/null) || {
            problems+=("no merge base between $source_branch and $target_branch in $source")
            merge_base=""
          }
        fi
      else
        remote_name_branch=""
        while IFS= read -r remote_ref; do
          remote_name_branch="${remote_ref#refs/remotes/}"
          [[ "$remote_name_branch" == */"$target_branch" ]] && break
          remote_name_branch=""
        done < <(git -C "$source" for-each-ref --format='%(refname)' refs/remotes)
        if [[ -n "$remote_name_branch" ]]; then
          problems+=("target branch exists only as a remote-tracking branch in $source: $target_branch")
          target_action="CREATE_BRANCH"
        else
          target_action="CREATE_BRANCH"
        fi
      fi

      target_actions[index]="$target_action"
      target_commits[index]="$target_commit"
      target_merge_bases[index]="$merge_base"
    done
  fi

  if (( ${#problems[@]} > 0 )); then
    echo "Task workspace preflight failed:" >&2
    for requested_branch in "${problems[@]}"; do
      echo "  - $requested_branch" >&2
    done
    return 1
  fi

  printf '%s\n' 'Task workspace plan'
  printf '  name:          %s\n' "$workspace_name"
  printf '  path:          %s\n' "$workspace_path"
  printf '  source branch: %s\n' "$source_branch"
  printf '  target branch: %s\n\n' "$target_branch"
  for (( index = 1; index <= ${#repo_names[@]}; index++ )); do
    printf '  %s\n' "${repo_names[index]}"
    printf '    source: %s @ %s\n' "${source_refs[index]}" "${source_commits[index]:0:7}"
    printf '    target: %s' "${target_actions[index]}"
    [[ "${target_actions[index]}" == REUSE_BRANCH ]] &&
      printf ' @ %s (merge-base %s)' "${target_commits[index]:0:7}" "${target_merge_bases[index]:0:7}"
    printf '\n    path:   %s\n' "${target_paths[index]}"
  done
  printf '\n'

  mkdir -p -- "$workspace_path" || {
    echo "task-workspace: failed to create workspace: $workspace_path" >&2
    return 1
  }

  for (( index = 1; index <= ${#repo_names[@]}; index++ )); do
    source="${repositories[index]:A}"
    if [[ "${target_actions[index]}" == CREATE_BRANCH ]]; then
      git -C "$source" worktree add -b "$target_branch" \
        "${target_paths[index]}" "${source_commits[index]}" || {
        echo "Task workspace creation failed after partial progress." >&2
        for requested_branch in "${created[@]}"; do
          echo "  created: $requested_branch" >&2
        done
        echo "  failed:  ${target_paths[index]}" >&2
        echo "Caller directory was not changed; no automatic cleanup was performed." >&2
        return 1
      }
    else
      git -C "$source" worktree add \
        "${target_paths[index]}" "$target_branch" || {
        echo "Task workspace creation failed after partial progress." >&2
        for requested_branch in "${created[@]}"; do
          echo "  created: $requested_branch" >&2
        done
        echo "  failed:  ${target_paths[index]}" >&2
        echo "Caller directory was not changed; no automatic cleanup was performed." >&2
        return 1
      }
    fi
    created+=("${target_paths[index]}")
  done

  cd -- "$workspace_path" || return 1
}

# Select one immediate child repository in the current task workspace and open
# it in tuicr. A supplied range is passed unchanged after validation.
review() {
  if (( $# > 1 )); then
    echo "Usage: review [git-revision-range]" >&2
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "review: fzf is required" >&2
    return 1
  fi
  if ! command -v tuicr >/dev/null 2>&1; then
    echo "review: tuicr is required" >&2
    return 1
  fi

  local workspace="${PWD:A}"
  local revision_range="${1:-}"
  local base_revision head_revision base_commit head_commit selected_root
  local repo_dir repo_root repo_name branch changed change_summary label selected selected_repo selected_changed marker
  local -i index=1
  local -a repo_dirs repo_changes labels

  while IFS= read -r -d '' repo_dir; do
    repo_root=$(git -C "$repo_dir" rev-parse --show-toplevel 2>/dev/null) || continue
    [[ "$repo_root" == "${repo_dir:A}" ]] || continue

    repo_name="${repo_dir:t}"
    branch=$(git -C "$repo_dir" symbolic-ref --quiet --short HEAD 2>/dev/null) || \
      branch="detached@$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null)"
    changed=$(git -C "$repo_dir" status --short --untracked-files=all 2>/dev/null | awk 'END { print NR + 0 }')
    if (( changed == 0 )); then
      change_summary="clean"
    else
      change_summary="$changed changes"
    fi

    repo_dirs+=("$repo_dir")
    repo_changes+=("$changed")
    marker=""
    [[ -L "$repo_dir" ]] && marker=" legacy-symlink"
    label=$(printf '%-24s %-12s %-24s%s' "$repo_name" "$change_summary" "$branch" "$marker")
    labels+=("$label")
  done < <(find "$workspace" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -print0 2>/dev/null)

  if (( ${#repo_dirs[@]} == 0 )); then
    echo "review: no immediate child Git repositories found in $workspace" >&2
    return 1
  fi

  selected=$(printf '%s\n' "${labels[@]}" | fzf \
    --height=40% --layout=reverse --border \
    --header='Repository                Changes      Branch') || return 0
  [[ -n "$selected" ]] || return 0

  while (( index <= ${#labels[@]} )); do
    if [[ "${labels[index]}" == "$selected" ]]; then
      selected_repo="${repo_dirs[index]}"
      selected_changed="${repo_changes[index]}"
      break
    fi
    (( index++ ))
  done

  [[ -n "$selected_repo" ]] || return 1
  [[ -d "$selected_repo" ]] || {
    echo "review: selected repository no longer exists: $selected_repo" >&2
    return 1
  }
  selected_root=$(git -C "$selected_repo" rev-parse --show-toplevel 2>/dev/null) || {
    echo "review: selected path is no longer a Git repository: $selected_repo" >&2
    return 1
  }
  [[ "${selected_root:A}" == "${selected_repo:A}" ]] || {
    echo "review: selected path is no longer a repository root: $selected_repo" >&2
    return 1
  }

  if [[ -n "$revision_range" ]]; then
    if [[ "$revision_range" == *"..."* ]]; then
      base_revision="${revision_range%%...*}"
      head_revision="${revision_range#*...}"
    elif [[ "$revision_range" == *".."* ]]; then
      base_revision="${revision_range%%..*}"
      head_revision="${revision_range#*..}"
    else
      echo "review: range must use base..head or base...head" >&2
      return 1
    fi

    if [[ -z "$base_revision" || -z "$head_revision" ||
          "$base_revision" == -* || "$head_revision" == -* ||
          "$base_revision" == *".."* || "$head_revision" == *".."* ]]; then
      echo "review: range must contain exactly two non-empty revisions" >&2
      return 1
    fi

    base_commit=$(git -C "$selected_repo" rev-parse --verify "$base_revision^{commit}" 2>/dev/null) || {
      echo "review: base revision is not a commit: $base_revision" >&2
      return 1
    }
    head_commit=$(git -C "$selected_repo" rev-parse --verify "$head_revision^{commit}" 2>/dev/null) || {
      echo "review: head revision is not a commit: $head_revision" >&2
      return 1
    }
    if [[ "$base_commit" == "$head_commit" ]]; then
      echo "review: base and head resolve to the same commit" >&2
      return 1
    fi
  fi

  (
    cd -- "$selected_repo" || exit 1
    if [[ -n "$revision_range" ]]; then
      command tuicr -r "$revision_range"
    elif (( selected_changed > 0 )); then
      command tuicr -w
    else
      command tuicr
    fi
  )
}

# List/search ~/.agents/skills, e.g. `skills`, `skills agent`, or `skills -d agent`.
skills() {
  local show_desc=0
  if [ "${1:-}" = "-d" ]; then
    show_desc=1
    shift
  fi
  local term="$*"
  local skills_dir="${SKILLS_DIR:-$HOME/.agents/skills}"
  [ -d "$skills_dir" ] || return 0

  local -a skill_files
  skill_files=("$skills_dir"/*/SKILL.md(N))
  (( ${#skill_files[@]} > 0 )) || return 0

  awk -v term="$term" -v show_desc="$show_desc" '
      function emit() {
        if (name == "") return
        if (needle == "" || index(tolower(name " " desc), needle) > 0) {
          if (show_desc) printf "%s — %s\n", name, desc
          else print name
        }
      }
      BEGIN { needle = tolower(term); squote = sprintf("%c", 39) }
      FNR==1 {
        if (NR>1) emit()
        file_name=FILENAME
        sub(/\/SKILL\.md$/, "", file_name)
        sub(/^.*\//, "", file_name)
        in_fm=0; name=file_name; desc=""; block=0
      }
      /^---[ \t]*$/ { in_fm++; if (in_fm==2) nextfile; next }
      in_fm==1 {
        if ($0 ~ /^name:[ \t]*/) {
          name=$0; sub(/^name:[ \t]*/,"",name); gsub(/^"|"$/,"",name)
          if (substr(name,1,1)==squote && substr(name,length(name),1)==squote) name=substr(name,2,length(name)-2)
          block=0
        } else if ($0 ~ /^description:[ \t]*/) {
          desc=$0; sub(/^description:[ \t]*/,"",desc)
          if (desc==">" || desc=="|" || desc==">-" || desc=="|-") { block=1; desc="" }
          else {
            gsub(/^"|"$/,"",desc)
            if (substr(desc,1,1)==squote && substr(desc,length(desc),1)==squote) desc=substr(desc,2,length(desc)-2)
            block=0
          }
        } else if (block==1 && $0 ~ /^[ \t]+/) {
          line=$0; sub(/^[ \t]+/,"",line); desc = (desc=="") ? line : desc " " line
        } else { block=0 }
      }
      END { emit() }
    ' "${skill_files[@]}" | sort -u | {
      if [ -n "$term" ]; then
        GREP_COLOR='38;5;213' grep --color=auto -iF -- "$term"
      else
        cat
      fi
    }
}
