# Copy to ~/.zshrc.local for machine/employer-specific settings that must NOT
# live in the shared repo. Sourced last by .zshrc, so it overrides everything.
# Untracked (see .gitignore).
#
# export HTTP_PROXY=http://proxy.corp:8080
# export HTTPS_PROXY=$HTTP_PROXY
# export KUBECONFIG=$HOME/.kube/work-config
# export PATH="$HOME/company-tools/bin:$PATH"
#
# Required by kprod/kprodtalos; keep the real production endpoint out of the repo.
# K8S_PROD_API_HOST=10.0.0.1
# K8S_PROD_TLS_SERVER_NAME=k8s-api.prod.example.internal
