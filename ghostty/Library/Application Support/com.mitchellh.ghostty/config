# Classic green-phosphor CRT terminal look (VT100-style), instead of a themed
# palette like Dracula. Only the base 16 ANSI colors are remapped to shades of
# green; the extended 256-color cube (16-255) is left at Ghostty's standard
# default so tools relying on it still render normally.
background = #000000
foreground = #33ff33
cursor-color = #33ff33
cursor-text = #000000

palette = 0=#000000
palette = 1=#1a661a
palette = 2=#33cc33
palette = 3=#4dff4d
palette = 4=#1a661a
palette = 5=#33cc33
palette = 6=#4dff4d
palette = 7=#33ff33
palette = 8=#003300
palette = 9=#33cc33
palette = 10=#4dff4d
palette = 11=#66ff66
palette = 12=#33cc33
palette = 13=#4dff4d
palette = 14=#66ff66
palette = 15=#99ff99
