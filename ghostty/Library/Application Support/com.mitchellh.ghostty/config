# "Phosphor-glow cyberpunk archaeology": an unlit CRT tube (true black, not
# Dracula's painted dark blue-grey) running vivid, modern Dracula colors.
# Green is the default phosphor trace (foreground/cursor); the rest of
# Dracula's real palette reads as status-LED/oscilloscope signal accents
# glowing against the void, cinema-grading style (deep black + neon accents).
font-family = "JetBrainsMono Nerd Font"
font-size = 14

background = #000000
foreground = #50fa7b
cursor-color = #50fa7b
cursor-text = #000000
selection-background = #44475a

palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff

# Notify when a long-running command finishes while its surface is unfocused.
# Pair the custom bell with a native macOS banner; disable Ghostty's notification
# sound in System Settings to avoid a second sound.
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 15s

bell-features = audio
bell-audio-path = /System/Library/Sounds/Submarine.aiff
bell-audio-volume = 0.35

# Task-workspace panes intentionally inherit the directory of the pane that
# created them, so AI, Yazi/shell, and review start from the same task root.
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
