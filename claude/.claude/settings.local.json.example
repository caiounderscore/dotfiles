{
  "_comment": "Per-machine Claude Code overrides. Copy to ~/.claude/settings.local.json on machines where you WANT the bilingual warm-up (e.g. personal Mac); leave it out on the work laptop. Claude Code merges this over the tracked settings.json. If you already have a settings.local.json (e.g. permissions), merge the hooks block into it instead of overwriting. Remove this _comment key before use.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/lang-warmup.sh\"",
            "timeout": 10,
            "statusMessage": "Loading language warm-up…"
          }
        ]
      }
    ]
  }
}
