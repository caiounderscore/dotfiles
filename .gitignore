.DS_Store
*.swp

# Per-machine, never-shared overrides (the .example templates ARE tracked).
.zshrc.local
.gitconfig-work
settings.local.json

# Secrets — belt-and-suspenders against an accidental commit.
*.pem
*.key
.env
.env.*
id_rsa
id_ed25519

# Shared AI runtime state and installer metadata stay outside the Stow package.
ai/.agents/state/
ai/.agents/.skill-lock.json
ai/.agents/skills/.antigravity-install-manifest.json

# Client packages are allowlists: everything except intentional adapters is runtime state.
claude/.claude.json*
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/hooks/
claude/.claude/hooks/*
!claude/.claude/hooks/lang-warmup.sh
!claude/.claude/agents/
claude/.claude/agents/*
!claude/.claude/agents/*.md
!claude/.claude/settings.json

codex/.codex/*
!codex/.codex/AGENTS.md
!codex/.codex/hooks.json
!codex/.codex/agents/
codex/.codex/agents/*
!codex/.codex/agents/*.toml
!codex/.codex/hooks/
codex/.codex/hooks/*
!codex/.codex/hooks/lang-warmup.sh
!codex/.codex/hooks/turn-complete-sound.sh
!codex/.codex/skills/
codex/.codex/skills/*
!codex/.codex/skills/tuicr-review
!codex/.codex/mcp-profiles/
codex/.codex/mcp-profiles/*
!codex/.codex/mcp-profiles/kubernetes-safe.toml

openclaude/.openclaude/*
!openclaude/.openclaude/CLAUDE.md

opencode/.config/opencode/*
!opencode/.config/opencode/AGENTS.md

# Repository-owned SwiftPM build output.
apps/FocusBreaks/.build/
